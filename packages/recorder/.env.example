# Workers API Configuration
WORKERS_API_URL=https://your-worker.your-subdomain.workers.dev
INTERNAL_API_KEY=your_internal_api_key_here

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=felix-radio-recordings

# OpenRouter (required) - STT via Qwen3 ASR
OPENROUTER_API_KEY=sk-or-v1-...
TRANSCRIPTION_MODEL=qwen/qwen3-asr-1.7b

# Timezone for recordings
TZ=Asia/Seoul

# Max STT attempts per recording (retried with backoff on failure, default 10)
STT_RETRY_MAX=10
